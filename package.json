    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@vladmandic/human": "3.3.6",
    "ethers": "6.13.4",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "sharp": "0.34.5",
    "tesseract.js": "7.0.0"
  }
