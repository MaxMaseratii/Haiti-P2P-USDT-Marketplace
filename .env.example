DATABASE_URL=postgres://postgres:postgres@localhost:5432/haiti_p2p
PORT=3000
# Used to sign login tokens. Change it. Long and random.
TOKEN_SECRET=change-me-to-a-long-random-string

# MOCK = fake money, fake OTP code 000000, fake chain. Safe for development.
# There is no real escrow adapter yet. See README ("Going live").
ESCROW_MODE=MOCK

# Haiti-only. When true, requests must carry a country header set by your CDN
# (for example CF-IPCountry: HT). Phone numbers must always be +509.
REQUIRE_HAITI_GEO=false
COUNTRY_HEADER=cf-ipcountry

# Timers (starting values from the spec. Tune after the pilot.)
LOCK_TIMEOUT_MIN=10
PAY_WINDOW_MIN=30
PAY_GRACE_MIN=10
SELLER_REPLY_MIN=30
EVIDENCE_HOURS=24

# Fee taken from the seller, in USDT/USDC. 0.005 = 0.5%
FEE_RATE=0.005

# Orders at or above this size need two agents to agree on a dispute.
DUAL_AGENT_HTG=50000

# Sellers with fewer than 5 completed sales are capped at this order size.
NEW_SELLER_CAP_HTG=10000

# How often the timer worker runs, in seconds.
WORKER_INTERVAL_SEC=15

# Optional: a text file of sanctioned names, one per line.
SANCTIONS_FILE=data/sanctions.txt
